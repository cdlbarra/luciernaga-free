# Supabase — obtener en: supabase.com > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # service_role (solo backend/ingestor)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... # anon key (dashboard)

# Ingestor URL (Render) — requerido para conectar el dashboard a la API
NEXT_PUBLIC_INGESTOR_URL=https://luciernaga-ingestor-v2.onrender.com

# Railway (ingestor) — se configura con: railway variables set
PORT=8080

# Chat IA (elegir uno)
OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...
